    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.3.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "vite": "^6.4.6"
  }
