---
import { profile, skills } from '../data/contenido';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="skills" aria-labelledby="skills-heading">
  <h2 id="skills-heading">{t(lang, 'skills')}</h2>
  {
    skills.map((group) => (
      <div>
        <h3>{group.name}</h3>
        <ul>
          {group.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    ))
  }
  <h3>{t(lang, 'languages')}</h3>
  <ul>{profile.languages.map((language) => <li>{language[lang]}</li>)}</ul>
</section>
