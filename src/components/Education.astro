---
import { education } from '../data/contenido';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="education" aria-labelledby="education-heading">
  <h2 id="education-heading">{t(lang, 'education')}</h2>
  <ul>
    {
      education.map((entry) => (
        <li>
          <h3>{entry.qualification[lang]}</h3>
          <p>{entry.institution[lang]}</p>
          <p>{entry.dates}</p>
        </li>
      ))
    }
  </ul>
</section>
