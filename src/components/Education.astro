---
import { education } from '../data/contenido';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="education" aria-labelledby="education-heading" class="section">
  <div class="wrap section-grid">
    <h2 id="education-heading" class="section-title reveal">
      {t(lang, 'education')}
    </h2>
    <ul class="grid gap-6">
      {
        education.map((entry) => (
          <li class="reveal flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <div>
              <h3 class="text-xl">{entry.qualification[lang]}</h3>
              <p class="text-muted">{entry.institution[lang]}</p>
            </div>
            <p class="label text-muted">{entry.dates}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
