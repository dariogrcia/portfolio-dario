---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Project } from '../data/types';
import { statusTone } from '../data/status';
import type { Lang } from '../i18n/ui';
import { localizedPath, t } from '../i18n/utils';
import ProjectDiagram from './ProjectDiagram.astro';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
// An empty glob is valid until the manual screenshot script has been run.
const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/projects/*/{desktop,mobile,detail}.png',
  { eager: true },
);
const screenshots = (['desktop', 'mobile', 'detail'] as const).flatMap(
  (viewport) => {
    const image = images[`../assets/projects/${project.slug}/${viewport}.png`];
    return project.media === 'screenshots' && image
      ? [{ viewport, image: image.default }]
      : [];
  },
);
---

<article aria-labelledby="project-heading" class="wrap pt-10 pb-24 sm:pt-14">
  <header class="intro max-w-3xl">
    <h1 id="project-heading" class="text-5xl sm:text-6xl">{project.name}</h1>
    <p class={`label status status-${statusTone(project)} mt-5`}>
      {project.status[lang]}
    </p>
    {
      project.tagline && (
        <p class="mt-4 font-medium text-muted">{project.tagline[lang]}</p>
      )
    }
    <p class="mt-6 font-serif text-xl leading-snug sm:text-2xl">
      {project.summary[lang]}
    </p>
  </header>

  <div class="mt-14 grid gap-12 lg:grid-cols-[1fr_18rem] lg:gap-16">
    <div class="grid max-w-3xl content-start gap-10">
      {
        (['role', 'problem', 'solution'] as const).map((field) =>
          project[field] ? (
            <section aria-labelledby={`${field}-heading`}>
              <h2 id={`${field}-heading`} class="label text-accent">
                {t(lang, field)}
              </h2>
              <p class="mt-3">{project[field][lang]}</p>
            </section>
          ) : null,
        )
      }
      {
        project.highlights && project.highlights[lang].length > 0 && (
          <section aria-labelledby="highlights-heading">
            <h2 id="highlights-heading" class="label text-accent">
              {t(lang, 'highlights')}
            </h2>
            <ul class="prose-list mt-3 grid gap-2.5">
              {project.highlights[lang].map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    <aside class="grid content-start gap-8 lg:sticky lg:top-24 lg:self-start">
      <section aria-labelledby="stack-heading" class="card p-6">
        <h2 id="stack-heading" class="label text-muted">
          {t(lang, 'technologyStack')}
        </h2>
        <ul class="chips mt-3">
          {project.stack.map((technology) => <li>{technology}</li>)}
        </ul>
        {
          project.url && (
            <p class="mt-6">
              <a
                class="btn btn-primary w-full justify-center"
                href={project.url}
              >
                {t(lang, 'visitWebsite')}
                <span aria-hidden="true">↗</span>
              </a>
            </p>
          )
        }
        {
          project.repo === 'private' && (
            <p class="mt-5 text-sm text-muted">
              {t(lang, 'privateRepository')}
            </p>
          )
        }
      </section>
    </aside>
  </div>

  {
    screenshots.length > 0 && (
      <section aria-labelledby="screenshots-heading" class="mt-20">
        <h2 id="screenshots-heading" class="label text-accent">
          {t(lang, 'screenshots')}
        </h2>
        <div class="gallery mt-6">
          {screenshots.map(({ viewport, image }) => (
            <figure class={viewport}>
              <div class="frame">
                <Image
                  src={image}
                  alt={`${project.name} — ${t(lang, viewport)}`}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption class="label mt-3 text-muted">
                {t(lang, viewport)}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }
  {
    project.media === 'diagram' &&
      (project.slug === 'ipso' || project.slug === 'nenufar') && (
        <section aria-labelledby="diagram-heading" class="mt-20">
          <h2 id="diagram-heading" class="label text-accent">
            {t(lang, 'architecture')}
          </h2>
          <div class="card reveal mt-6 flex justify-center p-6 text-ink sm:p-10">
            <ProjectDiagram slug={project.slug} lang={lang} />
          </div>
        </section>
      )
  }
  <a
    href={localizedPath('/#projects', lang)}
    class="mt-20 inline-flex items-center gap-2 font-semibold text-accent no-underline hover:underline"
  >
    <span aria-hidden="true">←</span>
    {t(lang, 'backToProjects')}
  </a>
</article>

<style>
  .gallery {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }

  @media (min-width: 48rem) {
    .gallery {
      grid-template-columns: 1fr minmax(0, 15rem);
    }
  }

  .frame {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 0.875rem;
    background: var(--surface);
    box-shadow: 0 24px 50px -32px rgb(0 0 0 / 0.5);
  }

  /* Optional close-up of one part of the site, full width under the pair. */
  .detail {
    grid-column: 1 / -1;
    max-width: 52rem;
  }

  .mobile .frame {
    border-radius: 1.5rem;
    max-width: 15rem;
  }

  figure img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
