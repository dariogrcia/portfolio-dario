---
import type { Project } from '../data/types';
import { statusTone } from '../data/status';
import type { Lang } from '../i18n/ui';
import { localizedPath, t } from '../i18n/utils';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const headingId = `project-${project.slug}-heading`;
const linkId = `project-${project.slug}-link`;
---

<article
  aria-labelledby={headingId}
  class="card relative flex h-full flex-col p-6 sm:p-7"
>
  <p class={`label status status-${statusTone(project)} self-start`}>
    {project.status[lang]}
  </p>
  <h3 id={headingId} class="mt-5 text-2xl">{project.name}</h3>
  {
    project.tagline && (
      <p class="mt-1 font-medium text-muted">{project.tagline[lang]}</p>
    )
  }
  <p class="mt-3 text-[0.975rem] text-muted">{project.summary[lang]}</p>
  <ul class="chips mt-5" aria-label={t(lang, 'technologyStack')}>
    {project.stack.map((technology) => <li>{technology}</li>)}
  </ul>
  <a
    id={linkId}
    href={localizedPath(`/projects/${project.slug}/`, lang)}
    aria-labelledby={`${linkId} ${headingId}`}
    class="stretched mt-auto inline-flex items-center gap-1.5 pt-6 font-semibold text-accent no-underline"
  >
    {t(lang, 'viewCase')}
    <span aria-hidden="true" class="arrow">→</span>
  </a>
</article>

<style>
  /* The whole card is clickable through the case-study link. */
  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .stretched:focus-visible {
    outline: none;
  }

  .stretched:focus-visible::after {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
    border-radius: 1rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .arrow {
      transition: transform 160ms ease;
    }

    article:hover .arrow {
      transform: translateX(4px);
    }
  }
</style>
