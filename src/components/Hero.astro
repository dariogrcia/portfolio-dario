---
import { profile } from '../data/contenido';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="hero" aria-labelledby="hero-heading" class="hero relative">
  <div class="wrap hero-content intro pt-16 pb-20 md:pt-24 md:pb-28">
    <p class="label text-accent">{profile.title[lang]}</p>
    <h1
      id="hero-heading"
      class="mt-4 max-w-4xl text-[2.6rem] leading-[1.05] sm:text-6xl lg:text-7xl"
    >
      {profile.name}
    </h1>
    <p
      class="mt-8 max-w-3xl font-serif text-2xl leading-snug text-ink sm:text-[1.75rem]"
    >
      {profile.headline[lang]}
    </p>
    <p class="mt-6 max-w-2xl text-muted">{profile.summary[lang]}</p>
    <p class="mt-6 flex items-start gap-2 text-sm text-muted">
      <span
        class="mt-1.5 size-2 shrink-0 rounded-full bg-[var(--live)]"
        aria-hidden="true"></span>
      {profile.location[lang]}
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a
        class="btn btn-primary"
        href="/cv/dario-garcia-aguilera-cv-en.pdf"
        download
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 20 20"
          class="size-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><path d="M10 3v10m0 0-4-4m4 4 4-4M4 16h12"></path></svg
        >
        {t(lang, 'downloadCv')}
      </a>
      <a class="btn btn-secondary" href="#contact">{t(lang, 'contactAction')}</a
      >
    </div>
  </div>
</section>

<style>
  .hero {
    isolation: isolate;
  }
</style>
