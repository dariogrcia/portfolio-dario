---
import { profile } from '../data/contenido';
import type { Lang } from '../i18n/ui';
import { t } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="hero" aria-labelledby="hero-heading">
  <h1 id="hero-heading">{profile.name}</h1>
  <p>{profile.title[lang]}</p>
  <p>{profile.headline[lang]}</p>
  <p>{profile.summary[lang]}</p>
  <p>{profile.location[lang]}</p>
  <div>
    <a href="/cv/dario-garcia-aguilera-cv-en.pdf" download
      >{t(lang, 'downloadCv')}</a
    >
    <a href="#contact">{t(lang, 'contactAction')}</a>
  </div>
</section>
