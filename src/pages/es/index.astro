---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Experience from '../../components/Experience.astro';
import Projects from '../../components/Projects.astro';
import AiWorkflow from '../../components/AiWorkflow.astro';
import Skills from '../../components/Skills.astro';
import Education from '../../components/Education.astro';
import Contact from '../../components/Contact.astro';
import { localizedPath, t } from '../../i18n/utils';

const lang = 'es';
---

<Base
  title={t(lang, 'pageTitle')}
  description={t(lang, 'pageDescription')}
  lang={lang}
  alternatePath={localizedPath(Astro.url.pathname, 'en')}
>
  <Hero lang={lang} />
  <Experience lang={lang} />
  <Projects lang={lang} />
  <AiWorkflow lang={lang} />
  <Skills lang={lang} />
  <Education lang={lang} />
  <Contact lang={lang} />
</Base>
