---
import LangSwitch from '../components/LangSwitch.astro';
import { profile } from '../data/contenido';
import type { Lang } from '../i18n/ui';
import { localizedPath, t } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  alternatePath: string;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, lang, alternatePath, ogImage, noindex } =
  Astro.props;
const site = Astro.site ?? import.meta.env.SITE;
if (!site) {
  throw new Error(
    'Configure site in astro.config.mjs to generate absolute SEO URLs.',
  );
}
const canonical = new URL(Astro.url.pathname, site);
const alternate = new URL(alternatePath, site);
const englishUrl = lang === 'en' ? canonical : alternate;
const spanishUrl = lang === 'es' ? canonical : alternate;
const imageUrl = new URL(ogImage ?? `/og/og-${lang}.png`, site);
const person = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': new URL('/#person', site).href,
  name: profile.name,
  url: new URL('/', site).href,
  jobTitle: profile.title[lang],
  description: profile.headline[lang],
  email: profile.email,
  sameAs: [profile.linkedin, profile.github],
}).replace(/</g, '\\u003c');
const sections = [
  { id: 'hero', label: 'hero' },
  { id: 'experience', label: 'experience' },
  { id: 'projects', label: 'projects' },
  { id: 'ai-workflow', label: 'aiWorkflow' },
  { id: 'skills', label: 'skills' },
  { id: 'education', label: 'education' },
  { id: 'contact', label: 'contact' },
] as const;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="es" href={spanishUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={imageUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={profile.headline[lang]} />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'es_ES'} />
    <meta
      property="og:locale:alternate"
      content={lang === 'en' ? 'es_ES' : 'en_GB'}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl.href} />
    <script is:inline type="application/ld+json" set:html={person} />
  </head>
  <body class="min-h-dvh">
    <canvas class="fluid-bg" aria-hidden="true"></canvas>
    <a
      href="#main-content"
      class="sr-only z-50 rounded-md bg-accent px-4 py-2 font-semibold text-on-accent focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      >{t(lang, 'skipToContent')}</a
    >
    <header
      class="site-header sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur-md"
    >
      <div class="wrap flex h-16 items-center gap-4">
        <a
          href={localizedPath('/', lang)}
          class="flex shrink-0 items-center gap-2.5 no-underline"
        >
          <span
            class="grid size-9 place-items-center rounded-lg bg-panel font-serif text-base font-semibold text-on-panel"
            aria-hidden="true">DG</span
          >
          <span class="sr-only">{profile.name}</span>
        </a>
        <nav
          aria-label={t(lang, 'mainNavigation')}
          class="nav-scroll -mx-1 min-w-0 flex-1 overflow-x-auto"
        >
          <ul class="flex w-max gap-1 px-1 text-sm">
            {
              sections.map(({ id, label }) => (
                <li>
                  <a
                    href={localizedPath(`/#${id}`, lang)}
                    class="block rounded-md px-2.5 py-1.5 whitespace-nowrap text-muted no-underline hover:bg-surface-2 hover:text-ink"
                  >
                    {t(lang, label)}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <LangSwitch lang={lang} alternatePath={alternatePath} />
      </div>
      <div class="scroll-progress" aria-hidden="true"></div>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <script>
      import { startFluidBackground } from '../scripts/fluidBackground';

      const canvas = document.querySelector<HTMLCanvasElement>('.fluid-bg');
      if (canvas) startFluidBackground(canvas);
    </script>
  </body>
</html>
